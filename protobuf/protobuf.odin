/*
Package protobuf is the runtime for Protocol Buffers messages generated by
odin-protoc. It implements the binary wire format
(https://protobuf.dev/programming-guides/encoding/).

Encoding is two-pass and allocation-free: a generated `<Msg>_size` computes
the exact encoded size in O(n), then `<Msg>_encode_fields` writes the message
*backwards* from the end of the destination buffer. Writing back to front
means a nested message's length is known right after its body is written, so
no size caching or re-sizing of sub-messages is needed.

Decoding allocates from a caller-supplied allocator (an arena is ideal).
Repeated fields are pre-counted so each array is normally allocated once at
its final size; growth beyond that is geometric. With
`Decode_Options.alias_input`, string and bytes fields reference the input
buffer instead of being copied.

Ownership: a message decoded into must be zero, or own all of its memory
with the decoder's allocator (e.g. from an earlier decode), because values
replaced during decoding are freed. Dynamic arrays and maps keep the
allocator they were created with. With alias_input nothing is freed during
decoding; use an arena allocator in that mode.
*/
package protobuf

import "base:runtime"

Wire_Type :: enum u8 {
	Varint      = 0,
	I64         = 1,
	Len         = 2,
	Start_Group = 3,
	End_Group   = 4,
	I32         = 5,
}

MIN_FIELD_NUMBER :: 1
MAX_FIELD_NUMBER :: (1 << 29) - 1
// Field numbers 19000-19999 are reserved by the protobuf implementation.
FIRST_RESERVED_FIELD_NUMBER :: 19000
LAST_RESERVED_FIELD_NUMBER :: 19999

MAX_VARINT_LEN :: 10
// DEFAULT_MAX_DEPTH bounds message nesting during decoding, protecting the
// stack against hostile input. It matches the limit used by the reference
// implementations.
DEFAULT_MAX_DEPTH :: 100

Error :: enum u8 {
	None,
	// The input ended in the middle of a value.
	Truncated,
	// A varint was longer than 10 octets.
	Malformed_Varint,
	// A tag had field number 0, a field number above the maximum, or an
	// invalid wire type.
	Invalid_Tag,
	// A length prefix exceeded the remaining input.
	Invalid_Length,
	// An END_GROUP tag did not match the open group, or a group was not closed.
	Invalid_Group,
	// A proto3 string field contained invalid UTF-8.
	Invalid_UTF8,
	// Message nesting exceeded Decode_Options.max_depth.
	Depth_Limit_Exceeded,
	// A proto2 `required` field was absent from a decoded message.
	Missing_Required_Field,
	// The destination buffer passed to an encoder is too small.
	Buffer_Too_Small,
	// A memory allocation failed.
	Out_Of_Memory,
}

Decode_Options :: struct {
	// When true, decoded `string` and `[]u8` fields point into the input
	// buffer instead of being copied; the input must outlive the message.
	alias_input:     bool,
	// When true, unknown fields are skipped instead of being preserved for
	// re-encoding.
	discard_unknown: bool,
	// Maximum message nesting; 0 selects DEFAULT_MAX_DEPTH.
	max_depth:       int,
}

// Message_Codec gives type-erased access to a generated message type. Code
// generated by odin-protoc provides one per message as `<Msg>_CODEC`; the
// gRPC runtime uses it to (un)marshal arbitrary request and response types.
Message_Codec :: struct {
	full_name:     string,
	size:          proc(msg: rawptr) -> int,
	encode_fields: proc(msg: rawptr, e: ^Encoder),
	decode_fields: proc(msg: rawptr, d: ^Decoder) -> Error,
}

// File_Descriptor is a .proto file's serialized
// google.protobuf.FileDescriptorProto, embedded in generated code by
// odin-protoc (each package lists its files in FILE_DESCRIPTORS). Server
// reflection serves these to clients.
File_Descriptor :: struct {
	name: string, // import path, e.g. "helloworld.proto"
	data: string, // serialized FileDescriptorProto
}

// marshal encodes msg into a newly allocated buffer of exactly its size.
marshal :: proc(msg: rawptr, codec: ^Message_Codec, allocator := context.allocator) -> (data: []u8, err: Error) {
	n := codec.size(msg)
	buf, alloc_err := make([]u8, n, allocator)
	if alloc_err != nil {
		return nil, .Out_Of_Memory
	}
	out, enc_err := encode_into(msg, codec, buf)
	if enc_err != .None {
		delete(buf, allocator)
		return nil, enc_err
	}
	assert(len(out) == n)
	return buf, .None
}

// encode_into encodes msg at the *end* of buf and returns the written
// suffix. buf must hold at least codec.size(msg) octets; when sized exactly,
// the returned slice is buf itself.
encode_into :: proc(msg: rawptr, codec: ^Message_Codec, buf: []u8) -> (data: []u8, err: Error) {
	e := encoder_make(buf)
	codec.encode_fields(msg, &e)
	if e.err != .None {
		return nil, e.err
	}
	return encoded(&e), .None
}

// unmarshal decodes data into msg, merging into any existing contents.
unmarshal :: proc(
	msg: rawptr,
	codec: ^Message_Codec,
	data: []u8,
	allocator := context.allocator,
	options := Decode_Options{},
) -> Error {
	d := decoder_make(data, allocator, options)
	return codec.decode_fields(msg, &d)
}

// view wraps existing memory as a non-owning repeated field, so that
// messages to encode can be built from slices (including slice literals)
// without allocating:
//
//     req := pb_gen.Batch{ids = pb.view([]i64{1, 2, 3})}
//
// The memory must outlive the message. Appending to a view fails, and
// freeing it is a no-op.
view :: proc(s: []$T) -> [dynamic]T {
	raw := runtime.Raw_Dynamic_Array {
		data      = raw_data(s),
		len       = len(s),
		cap       = len(s),
		allocator = runtime.nil_allocator(),
	}
	return transmute([dynamic]T)raw
}

@(private)
alloc_error ::#force_inline proc "contextless" (err: runtime.Allocator_Error) -> Error {
	return .Out_Of_Memory if err != nil else .None
}
